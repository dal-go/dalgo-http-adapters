{
  "name": "@dalgo/dalgo2upstash-redis",
  "version": "0.1.0",
  "description": "Browser-safe bounded read-only Upstash Redis REST executor with lossless RESP2 values",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "sideEffects": false,
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "check": "eslint . && vitest run && tsc -p tsconfig.json --noEmit && npm run build && node scripts/check-browser-bundle.mjs",
    "test": "vitest run",
    "prepack": "npm --prefix ../adapter-runtime run build && npm --prefix ../redis-resp run build && npm run build"
  },
  "license": "MIT",
  "engines": { "node": ">=20" },
  "peerDependencies": {
    "@dalgo/adapter-runtime": ">=0.1.2 <1.0.0",
    "@dalgo/core": ">=0.8.1 <0.9.0",
    "@dalgo/dalgo2redis-resp": ">=0.2.0 <1.0.0"
  },
  "devDependencies": {
    "@dalgo/adapter-runtime": "workspace:^",
    "@dalgo/core": "^0.8.1",
    "@dalgo/dalgo2redis-resp": "workspace:^",
    "@eslint/js": "10.0.1",
    "@types/node": "24.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "repository": { "type": "git", "url": "git+https://github.com/dal-go/dalgo-http-adapters.git", "directory": "packages/upstash-redis" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org" }
}
