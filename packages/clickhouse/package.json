{
  "name": "@dalgo/dalgo2clickhouse",
  "version": "0.2.0",
  "description": "Read-only anonymous ordinal ClickHouse HTTP executor for DALgo TypeScript",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "check": "eslint . && vitest run && tsc -p tsconfig.json --noEmit && npm run build",
    "lint": "eslint .",
    "prepack": "npm --prefix ../adapter-runtime run build && npm run build",
    "test": "vitest run",
    "test:real": "node scripts/real-clickhouse.mjs",
    "test:browser": "node scripts/real-clickhouse-browser.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dal-go/dalgo-http-adapters.git",
    "directory": "packages/clickhouse"
  },
  "bugs": {
    "url": "https://github.com/dal-go/dalgo-http-adapters/issues"
  },
  "homepage": "https://github.com/dal-go/dalgo-http-adapters/tree/main/packages/clickhouse#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@dalgo/core": ">=0.8.1 <0.9.0",
    "@dalgo/adapter-runtime": ">=0.2.0 <1.0.0"
  },
  "devDependencies": {
    "@dalgo/core": "^0.8.1",
    "@dalgo/adapter-runtime": "workspace:^",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
