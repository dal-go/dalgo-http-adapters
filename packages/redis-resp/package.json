{
  "name": "@dalgo/dalgo2redis-resp",
  "version": "0.1.0",
  "description": "Bounded read-only Redis RESP Node executor and browser-safe trusted HTTP client",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./node": { "types": "./dist/node.d.ts", "node": "./dist/node.js" },
    "./protocol": { "types": "./dist/protocol.d.ts", "import": "./dist/protocol.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "check": "eslint . && vitest run && tsc -p tsconfig.json --noEmit && npm run build && node scripts/check-browser-bundle.mjs",
    "test": "vitest run",
    "test:real": "node scripts/real-redis.mjs",
    "prepack": "npm --prefix ../adapter-runtime run build && npm run build"
  },
  "license": "MIT",
  "engines": { "node": ">=20" },
  "peerDependencies": { "@dalgo/adapter-runtime": ">=0.1.2 <1.0.0", "@dalgo/core": ">=0.8.1 <0.9.0" },
  "devDependencies": {
    "@dalgo/adapter-runtime": "workspace:^",
    "@dalgo/core": "^0.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "repository": { "type": "git", "url": "git+https://github.com/dal-go/dalgo-http-adapters.git", "directory": "packages/redis-resp" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org" }
}
