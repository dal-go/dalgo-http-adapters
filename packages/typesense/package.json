{
  "name": "@dalgo/dalgo2typesense",
  "version": "0.2.1",
  "description": "Bounded read-only native Typesense HTTP adapter for DALgo TypeScript",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:deps": "pnpm --filter \"@dalgo/dalgo2typesense...\" run build",
    "check": "eslint . && vitest run && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json && tsc -p tsconfig.examples.json",
    "lint": "eslint .",
    "prepack": "npm --prefix ../adapter-runtime run build && npm run build",
    "test": "vitest run",
    "test:real": "pnpm run build:deps && node scripts/real-typesense.mjs",
    "test:browser": "pnpm run build:deps && node scripts/real-typesense-browser.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dal-go/dalgo-http-adapters.git",
    "directory": "packages/typesense"
  },
  "bugs": {
    "url": "https://github.com/dal-go/dalgo-http-adapters/issues"
  },
  "homepage": "https://github.com/dal-go/dalgo-http-adapters/tree/main/packages/typesense#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@dalgo/adapter-runtime": ">=0.1.0 <1.0.0",
    "@dalgo/core": ">=0.7.4 <0.9.0"
  },
  "devDependencies": {
    "@dalgo/adapter-runtime": "workspace:^",
    "@dalgo/core": "^0.7.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
