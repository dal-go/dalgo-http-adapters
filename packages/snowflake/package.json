{
  "name": "@dal-go/dalgo2snowflake",
  "private": true,
  "version": "0.1.0",
  "description": "Read-only DALGO TypeScript adapter for the Snowflake SQL API",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "eslint . && tsc --noEmit && vitest run && npm run build",
    "lint": "eslint .",
    "test": "vitest run",
    "prepack": "npm --prefix ../adapter-runtime run build && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dal-go/dalgo-http-adapters.git",
    "directory": "packages/snowflake"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@dalgo/core": ">=0.8.1 <0.9.0",
    "@dalgo/adapter-runtime": ">=0.1.2 <1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1",
    "@dalgo/core": "^0.8.1",
    "@dalgo/adapter-runtime": "workspace:^"
  },
  "homepage": "https://github.com/dal-go/dalgo-http-adapters/tree/main/packages/snowflake#readme",
  "bugs": {
    "url": "https://github.com/dal-go/dalgo-http-adapters/issues"
  }
}
