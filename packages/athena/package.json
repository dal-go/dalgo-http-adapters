{
  "name": "@dalgo/dalgo2athena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bounded native Athena existing-table reads and scoped same-query pages",
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=1",
    "check": "eslint . && vitest run --maxWorkers=1 && tsc -p tsconfig.json --noEmit && npm run build && tsc -p tsconfig.examples.json && node scripts/check-browser.mjs",
    "prepack": "npm --prefix ../adapter-runtime run build && npm run build"
  },
  "peerDependencies": {
    "@dalgo/core": ">=0.8.1 <0.9.0",
    "@dalgo/adapter-runtime": ">=0.1.2 <1.0.0"
  },
  "dependencies": {
    "@smithy/signature-v4": "5.7.3"
  },
  "devDependencies": {
    "@dalgo/core": "0.8.1",
    "@dalgo/adapter-runtime": "workspace:^",
    "@types/node": "26.6.5",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dal-go/dalgo-http-adapters.git",
    "directory": "packages/athena"
  }
}
