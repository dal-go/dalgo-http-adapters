  "devDependencies": { "@dal-go/dalgo": "npm:@dalgo/core@0.8.1", "@eslint/js": "10.0.1", "eslint": "10.14.0", "typescript": "6.0.3", "typescript-eslint": "8.70.0", "vitest": "5.0.1" }
