{
  "name": "@dalgo/dalgo2mongodb",
  "version": "0.1.0",
  "description": "Read-only MongoDB Node executor and browser-safe trusted HTTP client for DALgo",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./browser": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./node": { "types": "./dist/node.d.ts", "import": "./dist/node.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "eslint . && vitest run && tsc -p tsconfig.json --noEmit && npm run build && npm run check:browser",
    "check:browser": "node scripts/check-browser.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:real": "node scripts/real-mongodb.ts",
    "test:browser": "MONGO_BROWSER_FIXTURE=1 node scripts/real-mongodb.ts",
    "prepack": "npm --prefix ../adapter-runtime run build && npm run build"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/dal-go/dalgo-http-adapters.git", "directory": "packages/mongodb" },
  "engines": { "node": ">=24" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org" },
  "peerDependencies": { "@dalgo/core": ">=0.8.1 <0.9.0", "@dalgo/adapter-runtime": ">=0.1.2 <1.0.0" },
  "dependencies": { "mongodb": "7.8.0" },
  "devDependencies": { "@dalgo/core": "^0.8.1", "@dalgo/adapter-runtime": "workspace:^", "@types/node": "26.6.5", "@eslint/js": "10.0.1", "esbuild": "0.28.2", "eslint": "10.11.0", "typescript": "6.0.3", "typescript-eslint": "8.70.0", "vitest": "5.0.1", "playwright": "1.64.1" }
}
