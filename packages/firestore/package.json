{
  "name": "@dalgo/firestore",
  "version": "0.4.2",
  "description": "Firestore Web SDK adapter for DALgo TypeScript",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tugql": {
      "types": "./dist/tugql.d.ts",
      "import": "./dist/tugql.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "eslint . && vitest run --exclude 'test/*.integration.test.ts' && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "prepack": "npm run build",
    "test": "vitest run --exclude 'test/*.integration.test.ts'",
    "test:emulator": "pnpm --package firebase-tools@15.30.2 dlx firebase emulators:exec --only firestore --project demo-dalgo-js-e2e \"vitest run integration.test\"",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dal-go/dalgo-http-adapters.git",
    "directory": "packages/firestore"
  },
  "bugs": {
    "url": "https://github.com/dal-go/dalgo-http-adapters/issues"
  },
  "homepage": "https://github.com/dal-go/dalgo-http-adapters/tree/main/packages/firestore#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@dalgo/core": ">=0.8.0 <0.9.0",
    "firebase": "^12.19.0 || ^13.1.0"
  },
  "devDependencies": {
    "@dalgo/core": "0.8.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "firebase": "12.19.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.5"
  }
}
