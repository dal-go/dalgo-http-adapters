{
  "name": "@dalgo/dalgo2couchdb",
  "version": "0.2.1",
  "description": "Apache CouchDB HTTP document and Mango adapter for DALgo TypeScript",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "eslint . && vitest run && tsc -p tsconfig.build.json && tsc -p tsconfig.examples.json",
    "lint": "eslint .",
    "prepack": "npm --prefix ../adapter-runtime run build && npm run build",
    "test": "vitest run",
    "test:native:live": "vitest run test/native-live.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dal-go/dalgo-http-adapters.git",
    "directory": "packages/couchdb"
  },
  "bugs": {
    "url": "https://github.com/dal-go/dalgo-http-adapters/issues"
  },
  "homepage": "https://github.com/dal-go/dalgo-http-adapters/tree/main/packages/couchdb#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22.13"
  },
  "peerDependencies": {
    "@dalgo/adapter-runtime": ">=0.1.0 <1.0.0",
    "@dalgo/core": ">=0.7.4 <0.9.0"
  },
  "devDependencies": {
    "@dalgo/adapter-runtime": "workspace:^",
    "@dalgo/core": "^0.7.4",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
