{
  "name": "@dalgo/d1",
  "version": "0.2.0",
  "description": "Read-only Cloudflare D1 binding and HTTP adapters for DALgo TypeScript",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "eslint . && vitest run && tsc -p tsconfig.build.json && tsc -p tsconfig.examples.json",
    "lint": "eslint .",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dal-go/dalgo-http-adapters.git",
    "directory": "packages/d1"
  },
  "bugs": { "url": "https://github.com/dal-go/dalgo-http-adapters/issues" },
  "homepage": "https://github.com/dal-go/dalgo-http-adapters/tree/main/packages/d1#readme",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20" },
  "peerDependencies": { "@dalgo/core": "^0.2.0" },
  "devDependencies": {
    "@dalgo/core": "^0.2.0",
    "@types/node": "26.6.2",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
