{
  "name": "@dalgo/bigquery",
  "version": "0.3.0",
  "description": "BigQuery REST API adapter for DALgo TypeScript",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./analytical": {
      "types": "./dist/analytical.d.ts",
      "import": "./dist/analytical.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "eslint . && vitest run && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dal-go/dalgo-http-adapters.git",
    "directory": "packages/bigquery"
  },
  "bugs": {
    "url": "https://github.com/dal-go/dalgo-http-adapters/issues"
  },
  "homepage": "https://github.com/dal-go/dalgo-http-adapters/tree/main/packages/bigquery#readme",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@dalgo/core": "^0.1.0"
  },
  "devDependencies": {
    "@dalgo/core": "0.1.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "fake-indexeddb": "6.2.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
